%%{init: {'theme': 'neutral'}}%%
erDiagram
    %% =======================================================
    %% Data Vault 2.0: Enterprise Historical Backbone
    %% =======================================================

    hub_customer ||--o{ link_order_customer : "Hash Key Join"
    hub_order ||--o{ link_order_customer : "Hash Key Join"
    hub_customer ||--o{ sat_customer_details : "Audit History"
    hub_order ||--o{ sat_order_details : "Status Timeline"

    hub_customer {
        string customer_pk PK "Hash Key (customer_id)"
        string customer_bk "Business Key"
        timestamp load_date "Load Timeline"
        string record_source "Traceability"
    }

    hub_order {
        string order_pk PK "Hash Key (order_id)"
        string order_bk "Business Key"
        timestamp load_date "Load Timeline"
        string record_source "Traceability"
    }

    link_order_customer {
        string link_order_customer_pk PK "Relationship Hash"
        string order_pk FK "Business Relationship"
        string customer_pk FK "Business Relationship"
        timestamp load_date
        string record_source
    }

    sat_customer_details {
        string sat_customer_details_pk PK "Delta Identifier"
        string customer_pk FK "Hub Parent"
        string customer_unique_id "Profile Data"
        string customer_city "Profile Data"
        string customer_state "Profile Data"
        timestamp load_date "Point-in-Time Trace"
        string record_source
    }

    sat_order_details {
        string sat_order_details_pk PK "Delta Identifier"
        string order_pk FK "Hub Parent"
        string order_status "Transitory State"
        timestamp order_purchase_timestamp "Business Event"
        timestamp load_date "Point-in-Time Trace"
        string record_source
    }

    %% Note for recruiters: 
    %% Data Vault was chosen for full auditability and 
    %% ability to reconstruct historical states at any 
    %% point without altering the schema (Insert-Only).
