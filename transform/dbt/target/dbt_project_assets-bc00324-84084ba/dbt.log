5(cast(coalesce(cast(order_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as link_order_customer_pk,\n        order_id as order_pk,\n        customer_id as customer_pk\n    from \"modeling_lab\".\"public\".\"stg_olist__orders\"\n)\n\nselect\n    link_order_customer_pk,\n    order_pk,\n    customer_pk,\n    current_timestamp as load_date,\n    'olist' as record_source\nfrom source\n  );\n  ", "name": "SQLQuery", "pid": 37147, "thread": "Thread-2 (worker)", "ts": "2026-02-24T17:57:58.489208Z"}}
