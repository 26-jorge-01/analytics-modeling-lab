{"data": {"conn_name": "list_modeling_lab_public", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"connection_name\": \"list_modeling_lab_public\"} */\nselect\n      'modeling_lab' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "94e2b434-5605-45b0-a986-22259bc72547", "level": "debug", "msg": "On list_modeling_lab_public: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"connection_name\": \"list_modeling_lab_public\"} */\nselect\n      'modeling_lab' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  ", "name": "SQLQuery", "pid": 37147, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-02-24T17:57:53.187641Z"}}
