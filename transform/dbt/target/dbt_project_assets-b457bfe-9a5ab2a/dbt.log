 * from renamed\n  );", "name": "SQLQuery", "pid": 31353, "thread": "Thread-3 (worker)", "ts": "2026-02-24T17:48:53.807823Z"}}
{"data": {"conn_name": "model.modeling_lab.dim_date", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "8609b2b2a6ba6610be2fe2c75f4929ebcf3574e0afbc30ba13acd1cb5eae4386", "node_finished_at": "", "node_name": "dim_date", "node_path": "marts/dim_date.sql", "node_relation": {"alias": "dim_date", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"dim_date\"", "schema": "public"}, "node_started_at": "2026-02-24T17:48:53.459943", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.dim_date"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.dim_date\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"dim_date__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    /*\r\n    Simple date dimension generation.\r\n    In a real project, we suggest using dbt_utils.date_spine or a static CSV.\r\n*/\r\n\r\nwith date_series as (\r\n    select generate_series(\r\n        '2016-01-01'::date,\r\n        '2019-12-31'::date,\r\n        '1 day'::interval\r\n    )::date as date_day\r\n),\r\n\r\nfinal as (\r\n    select\r\n        date_day as date_key,\r\n        date_day as full_date,\r\n        extract(year from date_day) as year,\r\n        extract(month from date_day) as month,\r\n        extract(day from date_day) as day,\r\n        extract(dow from date_day) as day_of_week,\r\n        to_char(date_day, 'Month') as month_name,\r\n        to_char(date_day, 'Day') as day_name,\r\n        case when extract(dow from date_day) in (0, 6) then true else false end as is_weekend\r\n    from date_series\r\n)\r\n\r\nselect * from final\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "ef758bbb-b2ec-4500-9b6b-cfab03c40332", "level": "debug", "msg": "On model.modeling_lab.dim_date: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.dim_date\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"dim_date__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    /*\r\n    Simple date dimension generation.\r\n    In a real project, we suggest using dbt_utils.date_spine or a static CSV.\r\n*/\r\n\r\nwith date_series as (\r\n    select generate_series(\r\n        '2016-01-01'::date,\r\n        '2019-12-31'::date,\r\n        '1 day'::interval\r\n    )::date as date_day\r\n),\r\n\r\nfinal as (\r\n    select\r\n        date_day as date_key,\r\n        date_day as full_date,\r\n        extract(year from date_day) as year,\r\n        extract(month from date_day) as month,\r\n        extract(day from date_day) as day,\r\n        extract(dow from date_day) as day_of_week,\r\n        to_char(date_day, 'Month') as month_name,\r\n        to_char(date_day, 'Day') as day_name,\r\n        case when extract(dow from date_day) in (0, 6) then true else false end as is_weekend\r\n    from date_series\r\n)\r\n\r\nselect * from final\n  );\n  ", "name": "SQLQuery", "pid": 31353, "thread": "Thread-1 (worker)", "ts": "2026-02-24T17:48:53.811580Z"}}
