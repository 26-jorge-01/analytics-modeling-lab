{"data": {"conn_name": "model.modeling_lab.link_order_customer", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "bb2d9be2bab79b1e90cf6b2f268b664e863a1d880aee9b5af6631e51b3f0d398", "node_finished_at": "", "node_name": "link_order_customer", "node_path": "intermediate/vault/links/link_order_customer.sql", "node_relation": {"alias": "link_order_customer", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"link_order_customer\"", "schema": "public"}, "node_started_at": "2026-02-24T17:48:58.544897", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.link_order_customer"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.link_order_customer\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"link_order_customer__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with source as (\n    select\n        md5(cast(coalesce(cast(order_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as link_order_customer_pk,\n        order_id as order_pk,\n        customer_id as customer_pk\n    from \"modeling_lab\".\"public\".\"stg_olist__orders\"\n)\n\nselect\n    link_order_customer_pk,\n    order_pk,\n    customer_pk,\n    current_timestamp as load_date,\n    'olist' as record_source\nfrom source\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "ef758bbb-b2ec-4500-9b6b-cfab03c40332", "level": "debug", "msg": "On model.modeling_lab.link_order_customer: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.link_order_customer\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"link_order_customer__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with source as (\n    select\n        md5(cast(coalesce(cast(order_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(customer_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as link_order_customer_pk,\n        order_id as order_pk,\n        customer_id as customer_pk\n    from \"modeling_lab\".\"public\".\"stg_olist__orders\"\n)\n\nselect\n    link_order_customer_pk,\n    order_pk,\n    customer_pk,\n    current_timestamp as load_date,\n    'olist' as record_source\nfrom source\n  );\n  ", "name": "SQLQuery", "pid": 31353, "thread": "Thread-1 (worker)", "ts": "2026-02-24T17:48:58.762889Z"}}
