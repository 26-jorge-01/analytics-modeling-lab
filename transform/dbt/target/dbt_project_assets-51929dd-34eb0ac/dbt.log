{"data": {"conn_name": "model.modeling_lab.core_customers", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "07e2bbbffa16fe557b41aeda4d95ff8ea217b704b5fba823ee6c5f0a2e0ae488", "node_finished_at": "", "node_name": "core_customers", "node_path": "intermediate/core/core_customers.sql", "node_relation": {"alias": "core_customers", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"core_customers\"", "schema": "public"}, "node_started_at": "2026-02-23T20:58:08.253152", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.core_customers"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.core_customers\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"core_customers__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with hubs as (\n    select * from \"modeling_lab\".\"public\".\"hub_customer\"\n),\n\nsats as (\n    select * from \"modeling_lab\".\"public\".\"sat_customer_details\"\n),\n\nlatest_sats as (\n    select *\n    from (\n        select \n            *,\n            row_number() over (partition by customer_pk order by load_date desc) as rn\n        from sats\n    ) where rn = 1\n)\n\nselect\n    h.customer_id,\n    s.customer_unique_id,\n    s.customer_zip_code_prefix,\n    s.customer_city,\n    s.customer_state\nfrom hubs h\ninner join latest_sats s on h.customer_pk = s.customer_pk\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "393661e6-8d36-45c6-8c98-c8e5f04a1014", "level": "debug", "msg": "On model.modeling_lab.core_customers: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.core_customers\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"core_customers__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with hubs as (\n    select * from \"modeling_lab\".\"public\".\"hub_customer\"\n),\n\nsats as (\n    select * from \"modeling_lab\".\"public\".\"sat_customer_details\"\n),\n\nlatest_sats as (\n    select *\n    from (\n        select \n            *,\n            row_number() over (partition by customer_pk order by load_date desc) as rn\n        from sats\n    ) where rn = 1\n)\n\nselect\n    h.customer_id,\n    s.customer_unique_id,\n    s.customer_zip_code_prefix,\n    s.customer_city,\n    s.customer_state\nfrom hubs h\ninner join latest_sats s on h.customer_pk = s.customer_pk\n  );\n  ", "name": "SQLQuery", "pid": 4569, "thread": "Thread-2 (worker)", "ts": "2026-02-23T20:58:08.379923Z"}}
