{"data": {"conn_name": "model.modeling_lab.fct_order_item", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "4c1ef27fdcf6cb5947eac81159007f09354d77fa587dd17fec86da6d7974352e", "node_finished_at": "", "node_name": "fct_order_item", "node_path": "marts/fct_order_item.sql", "node_relation": {"alias": "fct_order_item", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"fct_order_item\"", "schema": "public"}, "node_started_at": "2026-02-23T21:07:54.592256", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.fct_order_item"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.fct_order_item\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"fct_order_item__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with orders as (\n    select * from \"modeling_lab\".\"public\".\"core_orders\"\n),\n\norder_items as (\n    select * from \"modeling_lab\".\"public\".\"core_order_items\"\n),\n\njoined as (\n    select\n        -- Keys\n        oi.order_item_key,\n        oi.order_id,\n        oi.order_item_id,\n        o.customer_id,\n        oi.product_id,\n        oi.seller_id,\n        \n        -- Dates\n        cast(o.order_purchase_timestamp as date) as order_date,\n        \n        -- Dimensions from orders\n        o.order_status,\n        \n        -- Measures\n        oi.price,\n        oi.freight_value,\n        (oi.price + oi.freight_value) as total_value\n\n    from order_items oi\n    inner join orders o on oi.order_id = o.order_id\n)\n\nselect * from joined\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "f78ecd96-fb0e-445d-b484-134db46303bb", "level": "debug", "msg": "On model.modeling_lab.fct_order_item: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.fct_order_item\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"fct_order_item__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with orders as (\n    select * from \"modeling_lab\".\"public\".\"core_orders\"\n),\n\norder_items as (\n    select * from \"modeling_lab\".\"public\".\"core_order_items\"\n),\n\njoined as (\n    select\n        -- Keys\n        oi.order_item_key,\n        oi.order_id,\n        oi.order_item_id,\n        o.customer_id,\n        oi.product_id,\n        oi.seller_id,\n        \n        -- Dates\n        cast(o.order_purchase_timestamp as date) as order_date,\n        \n        -- Dimensions from orders\n        o.order_status,\n        \n        -- Measures\n        oi.price,\n        oi.freight_value,\n        (oi.price + oi.freight_value) as total_value\n\n    from order_items oi\n    inner join orders o on oi.order_id = o.order_id\n)\n\nselect * from joined\n  );\n  ", "name": "SQLQuery", "pid": 10618, "thread": "Thread-4 (worker)", "ts": "2026-02-23T21:07:54.833304Z"}}
