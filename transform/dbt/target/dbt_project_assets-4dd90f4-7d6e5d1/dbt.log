{"data": {"conn_name": "model.modeling_lab.fct_order_item", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "957dcad2df1db76e405e88ab1be3439f9cfc01298a2e82316ee5f312fc8d5f6e", "node_finished_at": "", "node_name": "fct_order_item", "node_path": "marts/star/fct_order_item.sql", "node_relation": {"alias": "fct_order_item", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"fct_order_item\"", "schema": "public"}, "node_started_at": "2026-02-19T01:19:02.231237", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.fct_order_item"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.fct_order_item\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"fct_order_item__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with orders as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__orders\"\n),\n\norder_items as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__order_items\"\n),\n\njoined as (\n    select\n        -- Keys\n        md5(cast(coalesce(cast(oi.order_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(oi.order_item_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as order_item_key,\n        oi.order_id,\n        oi.order_item_id,\n        o.customer_id,\n        oi.product_id,\n        oi.seller_id,\n        \n        -- Dates\n        cast(o.order_purchase_timestamp as date) as order_date,\n        \n        -- Dimensions from orders\n        o.order_status,\n        \n        -- Measures\n        oi.price,\n        oi.freight_value,\n        (oi.price + oi.freight_value) as total_value\n\n    from order_items oi\n    inner join orders o on oi.order_id = o.order_id\n)\n\nselect * from joined\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "5b3b1723-51f2-4673-a15d-56ee53f3aef4", "level": "debug", "msg": "On model.modeling_lab.fct_order_item: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.fct_order_item\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"fct_order_item__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with orders as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__orders\"\n),\n\norder_items as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__order_items\"\n),\n\njoined as (\n    select\n        -- Keys\n        md5(cast(coalesce(cast(oi.order_id as TEXT), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(oi.order_item_id as TEXT), '_dbt_utils_surrogate_key_null_') as TEXT)) as order_item_key,\n        oi.order_id,\n        oi.order_item_id,\n        o.customer_id,\n        oi.product_id,\n        oi.seller_id,\n        \n        -- Dates\n        cast(o.order_purchase_timestamp as date) as order_date,\n        \n        -- Dimensions from orders\n        o.order_status,\n        \n        -- Measures\n        oi.price,\n        oi.freight_value,\n        (oi.price + oi.freight_value) as total_value\n\n    from order_items oi\n    inner join orders o on oi.order_id = o.order_id\n)\n\nselect * from joined\n  );\n  ", "name": "SQLQuery", "pid": 4845, "thread": "Thread-1 (worker)", "ts": "2026-02-19T01:19:02.445377Z"}}
