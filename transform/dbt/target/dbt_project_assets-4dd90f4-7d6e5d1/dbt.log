{"data": {"conn_name": "model.modeling_lab.dim_product", "node_info": {"materialized": "table", "meta": {}, "node_checksum": "ecb54e882e9f70226084c51f37ee69481c15ac9a2ba07a44153e4773af00bf73", "node_finished_at": "", "node_name": "dim_product", "node_path": "marts/star/dim_product.sql", "node_relation": {"alias": "dim_product", "database": "modeling_lab", "relation_name": "\"modeling_lab\".\"public\".\"dim_product\"", "schema": "public"}, "node_started_at": "2026-02-19T01:19:01.788939", "node_status": "executing", "resource_type": "model", "unique_id": "model.modeling_lab.dim_product"}, "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.dim_product\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"dim_product__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with products as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__products\"\n),\n\ncategories as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__category_translations\"\n),\n\njoined as (\n    select\n        p.product_id,\n        coalesce(c.product_category_name_english, p.product_category_name) as product_category,\n        p.product_name_lenght,\n        p.product_description_lenght,\n        p.product_photos_qty,\n        p.product_weight_g,\n        p.product_length_cm,\n        p.product_height_cm,\n        p.product_width_cm\n    from products p\n    left join categories c on p.product_category_name = c.product_category_name\n)\n\nselect * from joined\n  );\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "5b3b1723-51f2-4673-a15d-56ee53f3aef4", "level": "debug", "msg": "On model.modeling_lab.dim_product: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"node_id\": \"model.modeling_lab.dim_product\"} */\n\n  \n    \n\n  create  table \"modeling_lab\".\"public\".\"dim_product__dbt_tmp\"\n  \n  \n    as\n  \n  (\n    with products as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__products\"\n),\n\ncategories as (\n    select * from \"modeling_lab\".\"public\".\"stg_olist__category_translations\"\n),\n\njoined as (\n    select\n        p.product_id,\n        coalesce(c.product_category_name_english, p.product_category_name) as product_category,\n        p.product_name_lenght,\n        p.product_description_lenght,\n        p.product_photos_qty,\n        p.product_weight_g,\n        p.product_length_cm,\n        p.product_height_cm,\n        p.product_width_cm\n    from products p\n    left join categories c on p.product_category_name = c.product_category_name\n)\n\nselect * from joined\n  );\n  ", "name": "SQLQuery", "pid": 4845, "thread": "Thread-2 (worker)", "ts": "2026-02-19T01:19:01.992745Z"}}
