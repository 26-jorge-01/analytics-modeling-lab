{"data": {"conn_name": "list_modeling_lab_public", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"connection_name\": \"list_modeling_lab_public\"} */\nselect\n      'modeling_lab' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "2729baf9-d28a-4ac1-9e08-8853e125d518", "level": "debug", "msg": "On list_modeling_lab_public: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.6\", \"profile_name\": \"modeling_lab\", \"target_name\": \"dev\", \"connection_name\": \"list_modeling_lab_public\"} */\nselect\n      'modeling_lab' as database,\n      tablename as name,\n      schemaname as schema,\n      'table' as type\n    from pg_tables\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      viewname as name,\n      schemaname as schema,\n      'view' as type\n    from pg_views\n    where schemaname ilike 'public'\n    union all\n    select\n      'modeling_lab' as database,\n      matviewname as name,\n      schemaname as schema,\n      'materialized_view' as type\n    from pg_matviews\n    where schemaname ilike 'public'\n  ", "name": "SQLQuery", "pid": 8244, "thread": "ThreadPoolExecutor-1_0", "ts": "2026-02-19T01:24:27.451031Z"}}
